# AI Document Studio - Environment Variables

# Gemini API Key - Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Optional: required for PDF export on Vercel
PDF_CONVERTER_URL=
PDF_CONVERTER_TOKEN=

# Application settings
NEXT_PUBLIC_APP_NAME="AI Document Studio"
NODE_ENV=development
