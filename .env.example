# AI Document Studio - Environment Variables

# Gemini API Key - Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# MongoDB Atlas for saved documents, itinerary photos, and vector search
MONGODB_URI=
MONGODB_DB=doc_theme

# Optional persistent directory for SQLite and local exports
STUDIO_DATA_DIR=

# Optional: required for PDF export on Vercel
PDF_CONVERTER_URL=
PDF_CONVERTER_TOKEN=

# Required for new accounts. Use a verified Resend sender and the public HTTPS origin.
RESEND_API_KEY=
VERIFICATION_EMAIL_FROM=
STUDIO_PUBLIC_URL=http://localhost:3000

# Application settings
NEXT_PUBLIC_APP_NAME="AI Document Studio"
NODE_ENV=development
